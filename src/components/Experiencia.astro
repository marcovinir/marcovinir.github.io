---
import { cvData, type Lang } from '../data';
import { t } from '../i18n/ui';
import Timeline from './Timeline.astro';
interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const { experience } = cvData(lang);
const ui = t(lang).experiencia;
---

<section id="experiencia" data-accent="#38bdf8">
  <div class="inner">
    <div class="kicker reveal">{ui.kicker}</div>
    <h2 class="reveal">{ui.title}</h2>
    <div class="reveal"><Timeline entries={experience} /></div>
  </div>
</section>

<style>
  #experiencia { min-height: 70vh; background: radial-gradient(ellipse at 80% 50%, #0c1a33 0, var(--bg) 60%); }
  .kicker { color: var(--muted); }
</style>
