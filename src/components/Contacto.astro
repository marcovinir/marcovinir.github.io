---
import { cvData, type Lang } from '../data';
import { t } from '../i18n/ui';
interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const { person } = cvData(lang);
const ui = t(lang).contacto;
---

<section id="contacto" data-accent="#ffffff">
  <div class="grid">
    <div class="side">
      <h2 class="reveal">{ui.title}</h2>

      <ul class="links reveal">
        <li class="mail">
          <a href={`mailto:${person.email}`}><span class="addr">{person.email}</span></a>
          <button class="copy" type="button" data-email={person.email} data-copied={ui.copied}>{ui.copy}</button>
        </li>
        <li><a href={person.phoneHref}>{person.phone}</a></li>
        <li><a href={person.linkedin} target="_blank" rel="noopener">{ui.linkedin}</a></li>
      </ul>
    </div>

    <form class="form reveal" action={person.formEndpoint} method="POST"
      data-success={ui.success} data-error={ui.error} data-email={person.email} data-sending={ui.sending}>
      <div class="row">
        <label>
          <span>{ui.name}</span>
          <input name="name" type="text" autocomplete="name" required maxlength="100" />
        </label>
        <label>
          <span>{ui.email}</span>
          <input name="email" type="email" autocomplete="email" required maxlength="150" />
        </label>
      </div>
      <label>
        <span class="msg-head">{ui.message} <span class="counter" aria-live="polite">0/500</span></span>
        <textarea name="message" rows="5" required maxlength="500"></textarea>
      </label>
      <!-- Campo trampa para bots: las personas no lo ven. -->
      <input class="trap" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <button class="cta send" type="submit">{ui.send}</button>
      <p class="status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<style>
  #contacto { min-height: 80vh; --accent: #fff; --accent2: #fff; background: linear-gradient(180deg, var(--bg), #0a0b12); }
  .grid { position: relative; z-index: 2; width: 100%; max-width: 1150px; display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: 6vw; align-items: start; }

  .side h2 { margin-top: 0; }
  .links { list-style: none; margin-top: 22px; display: grid; gap: 10px; font-size: 16px; }
  .links a { color: var(--text); text-underline-offset: 4px; }
  .links a:hover { color: var(--c1); }
  .mail { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .mail a { font-weight: 600; overflow-wrap: anywhere; }
  .copy { font: inherit; font-size: 13px; font-weight: 600; padding: 6px 10px; border-radius: 10px; background: #ffffff14; color: var(--muted); cursor: pointer; border: 0; }
  .copy:hover { color: var(--text); }
  .copy.ok { color: var(--c2); }

  .form { display: grid; gap: 22px; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  label { display: grid; gap: 8px; font-size: 13px; color: var(--muted); }
  .msg-head { display: flex; justify-content: space-between; }
  input, textarea {
    font: inherit; font-size: 16px; color: var(--text); background: transparent;
    border: 0; border-bottom: 1px solid #ffffff33; padding: 8px 2px; resize: vertical; transition: border-color .3s;
  }
  input:focus, textarea:focus { outline: none; border-bottom-color: var(--c1); }
  input:focus-visible, textarea:focus-visible { box-shadow: 0 2px 0 0 var(--c1); }
  .trap { display: none; }
  .send { margin-top: 4px; justify-self: start; border: 0; cursor: pointer; font: inherit; font-weight: 700; }
  .send[disabled] { opacity: .6; cursor: wait; }
  .status { min-height: 1.4em; font-size: 15px; color: var(--muted); }
  .status.ok { color: var(--c2); }
  .status.bad { color: var(--c3); }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) { .row { grid-template-columns: 1fr; } }
</style>

<script>
  // Copia el correo. Sin portapapeles disponible, lo deja seleccionado para copiarlo a mano.
  document.querySelectorAll<HTMLButtonElement>('.copy').forEach(btn => {
    btn.addEventListener('click', async () => {
      const email = btn.dataset.email ?? '';
      try {
        if (!navigator.clipboard?.writeText) throw new Error('sin portapapeles');
        await navigator.clipboard.writeText(email);
        btn.textContent = btn.dataset.copied ?? 'Copiado';
        btn.classList.add('ok');
      } catch {
        const addr = btn.parentElement?.querySelector('.addr');
        const sel = getSelection();
        if (addr && sel) {
          const range = document.createRange();
          range.selectNodeContents(addr);
          sel.removeAllRanges();
          sel.addRange(range);
        }
      }
    });
  });

  // Formulario: contador de caracteres y envío a Formspree sin salir de la página.
  document.querySelectorAll<HTMLFormElement>('#contacto form').forEach(form => {
    const message = form.querySelector('textarea')!;
    const counter = form.querySelector('.counter')!;
    const status = form.querySelector<HTMLElement>('.status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const updateCounter = () => { counter.textContent = `${message.value.length}/${message.maxLength}`; };
    message.addEventListener('input', updateCounter);

    form.addEventListener('submit', async event => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const name = (form.elements.namedItem('name') as HTMLInputElement).value.trim();
      const label = button.textContent;
      button.disabled = true;
      button.textContent = form.dataset.sending ?? label;
      status.className = 'status';
      status.textContent = '';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        status.textContent = (form.dataset.success ?? '').replace('{name}', name);
        status.classList.add('ok');
        form.reset();
        updateCounter();
      } catch {
        status.textContent = (form.dataset.error ?? '').replace('{email}', form.dataset.email ?? '');
        status.classList.add('bad');
      } finally {
        button.disabled = false;
        button.textContent = label;
      }
    });
  });
</script>
