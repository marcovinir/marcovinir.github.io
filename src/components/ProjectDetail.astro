---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import LangSwitch from './LangSwitch.astro';
import Footer from './Footer.astro';
import type { Lang } from '../data';
import { detalles, detailPath, type Shot } from '../data/detalles';
import { t } from '../i18n/ui';

interface Props { lang?: Lang; slug: string }
const { lang = 'es', slug } = Astro.props;
const d = detalles[lang][slug];
const ui = t(lang);
const other: Lang = lang === 'es' ? 'en' : 'es';

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/proyectos/*/*.{png,jpg,gif}', { eager: true });
const img = (s: Shot) => images[`../assets/proyectos/${slug}/${s.file}`].default;
const arrow = '<svg width="13" height="13" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 11L11 5M6 5h5v5" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" /></svg>';
---

<Base
  title={`${d.name} · Marco Rojas`}
  description={d.intro[0]}
  lang={lang}
  translated
  pairs={{ es: detailPath('es', slug), en: detailPath('en', slug) }}
>
  <LangSwitch lang={lang} href={detailPath(other, slug)} />
  <main class="detail">
    <a class="back" href={d.backTo}>← {ui.detail.back}</a>

    <header>
      <div class="kicker">{ui.areasIntro.kicker}</div>
      <h1>{d.name}</h1>
      {d.intro.map(p => <p class="lead">{p}</p>)}
      <p class="role"><b>{ui.detail.role}:</b> {d.role}</p>
      <div class="actions">
        {d.demo && <a class="cta" href={d.demo} target="_blank" rel="noopener">{ui.project.demo} <Fragment set:html={arrow} /></a>}
        {d.code && <a class="cta ghost" href={d.code} target="_blank" rel="noopener">{ui.project.code} <Fragment set:html={arrow} /></a>}
      </div>
    </header>

    <section class="block">
      <h2>{d.featuresTitle ?? ui.detail.built}</h2>
      <ul class="features">{d.features.map(f => <li>{f}</li>)}</ul>
      <h3>{ui.detail.stack}</h3>
      <ul class="chips">{d.stack.map(s => <li class="chip">{s}</li>)}</ul>
    </section>

    {d.challenges && (
      <section class="block">
        <h2>{ui.detail.challenges}</h2>
        <div class="challenges">
          {d.challenges.map(c => (
            <article>
              <h3>{c.title}</h3>
              <p>{c.text}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    {d.galleries.map(g => (
      <section class="block">
        <h2>{g.title}</h2>
        <div class={`gallery gallery-${g.id}`}>
          {g.shots.map(s => (
            <figure>
              <a href={img(s).src} target="_blank" rel="noopener">
                {/* Los GIF se sirven tal cual para conservar la animación. */}
                {s.file.endsWith('.gif')
                  ? <img src={img(s).src} alt={s.alt} width={img(s).width} height={img(s).height} loading="lazy" />
                  : <Image src={img(s)} alt={s.alt} widths={[640, 960, 1400]} sizes="(max-width: 800px) 92vw, 560px" loading="lazy" />}
              </a>
              <figcaption>{s.caption}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    ))}
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .detail { max-width: 1180px; margin: 0 auto; padding: 72px 6vw 40px; --accent: #34d399; --accent2: #a3e635; }
  .back { display: inline-block; color: var(--muted); text-decoration: none; font-size: 14px; }
  .back:hover { color: var(--text); }
  header { margin-top: 28px; max-width: 760px; }
  .kicker { color: var(--accent); }
  h1 { margin-top: 12px; font-size: clamp(38px, 5.5vw, 64px); }
  .lead { max-width: 720px; }
  .role { color: var(--muted); margin-top: 18px; font-size: 15px; line-height: 1.6; }
  .role b { color: var(--text); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .cta { margin-top: 24px; }
  .cta.ghost { background: transparent; color: var(--text); border: 1px solid #ffffff40; }
  .cta.ghost:hover { border-color: #fff; box-shadow: 0 10px 40px #ffffff1a; }
  /* Las secciones de la página de detalle no ocupan pantalla completa. */
  .block { min-height: auto; display: block; padding: 0; margin-top: 64px; overflow: visible; }
  h2 { margin-top: 0; font-size: clamp(28px, 3.4vw, 40px); }
  h3 { margin-top: 26px; font-size: 18px; }
  .features { margin-top: 18px; padding-left: 20px; color: var(--muted); line-height: 1.7; max-width: 820px; }
  .features li::marker { color: var(--accent); }
  .challenges { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; margin-top: 22px; }
  .challenges article { padding: 20px 22px; border-radius: 16px; border: 1px solid #ffffff1a; background: linear-gradient(135deg, #ffffff0a, #ffffff02); }
  .challenges h3 { margin-top: 0; color: var(--text); }
  .challenges p { color: var(--muted); font-size: 15px; line-height: 1.6; margin-top: 8px; }
  .gallery { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; margin-top: 24px; }
  figure { margin: 0; }
  figure a { display: block; border-radius: 14px; overflow: hidden; border: 1px solid #ffffff1a; transition: border-color .3s, transform .3s; }
  figure a:hover, figure a:focus-visible { border-color: var(--accent); transform: translateY(-3px); }
  figure :global(img) { display: block; width: 100%; height: auto; }
  .gallery-mascota, .gallery-pantallas { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; align-items: start; }
  .gallery-mascota a { background: #f4efe6; }
  .gallery-mascota :global(img) { image-rendering: pixelated; }
  figcaption { margin-top: 10px; color: var(--muted); font-size: 14px; line-height: 1.5; }
  @media (max-width: 800px) { .gallery, .challenges { grid-template-columns: 1fr; } .gallery-mascota, .gallery-pantallas { grid-template-columns: repeat(2, minmax(0, 1fr)); } .detail { padding-top: 64px; } }
</style>
