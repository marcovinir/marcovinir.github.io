---
import { workflow } from '../data/cv';
---

<section id="como-trabajo" data-accent="#a78bfa">
  <div class="wrap">
    <div class="kicker reveal">Proceso</div>
    <h2 class="reveal">Cómo trabajo</h2>
    <ol class="steps reveal">
      {workflow.map((s, i) => (
        <li class="step" style={`--i:${i}`} tabindex="0">
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
          <p class="example"><span>Ejemplo</span>{s.example}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  #como-trabajo { min-height: 80vh; background: linear-gradient(180deg, var(--bg), #0a0b14 50%, var(--bg)); }
  .wrap { position: relative; z-index: 2; width: 100%; max-width: 1150px; }
  .kicker { color: var(--muted); }
  .steps { list-style: none; position: relative; display: grid; grid-template-columns: repeat(5, 1fr); gap: 22px; margin-top: 44px; }
  .steps::before {
    content: ""; position: absolute; left: 0; right: 0; top: 22px; height: 2px;
    background: var(--spectrum); opacity: .5;
  }
  .step { position: relative; padding-top: 64px; outline: none; }
  .num {
    position: absolute; top: 0; left: 0; width: 46px; height: 46px; border-radius: 50%;
    display: grid; place-items: center; font-weight: 800; font-size: 14px;
    background: var(--bg); border: 2px solid #ffffff33; color: var(--muted);
    transition: border-color .5s, color .5s, box-shadow .5s, transform .3s;
    transition-delay: calc(var(--i) * 150ms), calc(var(--i) * 150ms), calc(var(--i) * 150ms), 0s;
  }
  .step:nth-child(1) { --c: var(--c1); }
  .step:nth-child(2) { --c: var(--c2); }
  .step:nth-child(3) { --c: var(--c3b); }
  .step:nth-child(4) { --c: var(--c3); }
  .step:nth-child(5) { --c: var(--c4b); }
  .in .num, :global(html:not(.js)) .num { border-color: var(--c); color: var(--text); box-shadow: 0 0 24px color-mix(in srgb, var(--c) 45%, transparent); }
  .step:hover .num, .step:focus-visible .num { transform: scale(1.12); }
  .step:focus-visible h3 { text-decoration: underline; text-decoration-color: var(--c); text-underline-offset: 5px; }
  h3 { font-size: 20px; font-weight: 700; }
  p { color: var(--muted); font-size: 15px; line-height: 1.55; margin-top: 8px; }

  /* Ejemplo real de cada paso: aparece al pasar el mouse o al enfocar con teclado. */
  .example {
    margin-top: 12px; padding: 10px 12px; border-radius: 12px; font-size: 13.5px; color: var(--text);
    border: 1px solid color-mix(in srgb, var(--c) 45%, transparent);
    background: color-mix(in srgb, var(--c) 10%, transparent);
    opacity: 0; transform: translateY(6px); transition: opacity .3s, transform .3s;
  }
  .example span { display: block; font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--c); margin-bottom: 3px; }
  .step:hover .example, .step:focus-visible .example, .step:focus-within .example { opacity: 1; transform: none; }
  /* Sin mouse (celulares y tabletas) no hay hover: se muestran siempre. */
  @media (hover: none) { .example { opacity: 1; transform: none; } }

  @media (max-width: 1000px) { .steps { grid-template-columns: repeat(3, 1fr); row-gap: 36px; } .steps::before { display: none; } }
  @media (max-width: 700px) {
    .steps { grid-template-columns: 1fr; gap: 8px; }
    .steps::before { display: block; left: 22px; right: auto; top: 0; bottom: 0; width: 2px; height: auto; background: linear-gradient(var(--c1), var(--c2), var(--c3b), var(--c3), var(--c4b)); }
    .step { padding: 0 0 24px 70px; min-height: 60px; }
    .example { opacity: 1; transform: none; }
  }
</style>
