    </defs>
    <g class="block"><polygon points="200,40 260,75 200,110 140,75" fill="url(#iso-top)" /><polygon points="140,75 200,110 200,170 140,135" fill="#10b98199" /><polygon points="260,75 200,110 200,170 260,135" fill="#05966999" /></g>
