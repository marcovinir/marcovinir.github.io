    <g class="block"><polygon points="290,130 350,165 290,200 230,165" fill="url(#iso-top)" opacity=".85" /><polygon points="230,165 290,200 290,240 230,205" fill="#10b98177" /><polygon points="350,165 290,200 290,240 350,205" fill="#05966977" /></g>
