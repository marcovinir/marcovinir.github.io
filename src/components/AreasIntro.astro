---
import type { Lang } from '../data';
import { t } from '../i18n/ui';
interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const ui = t(lang).areasIntro;
---

<section id="areas" data-accent="#ffffff">
  <div class="inner">
    <div class="kicker reveal">{ui.kicker}</div>
    <h2 class="reveal">{ui.titleStart} <span class="grad-spectrum">{ui.titleAccent}</span></h2>
  </div>
</section>

<style>
  #areas { min-height: auto; padding-top: 80px; padding-bottom: 20px; }
  .kicker { color: var(--muted); }
</style>
