---
import type { Project } from '../data/cv';
import type { Lang } from '../data';
import { t } from '../i18n/ui';
import { detailPath } from '../data/detalles';

interface Props {
  project: Project;
  accent: string;
  accent2: string;
  lang?: Lang;
}

const { project, accent, accent2, lang = 'es' } = Astro.props;
const ui = t(lang).project;
const arrow = '<svg width="13" height="13" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 11L11 5M6 5h5v5" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" /></svg>';
---

<article class="proj" style={`--accent:${accent};--accent2:${accent2}`}>
  <span class="bar" aria-hidden="true"></span>
  <div class="body">
    <div class="name">
      <b>{project.name}{project.inProgress && ` · ${ui.inProgress}`}</b>
      {project.team && <span class="tag">{ui.team}</span>}
    </div>
    <small>{project.summary} · {project.stack}</small>
    {project.detail && <p class="hint">{ui.detailsHint}</p>}
    <div class="links">
      {project.detail && <a class="details-btn" href={detailPath(lang, project.detail)}>{ui.details} <span aria-hidden="true">→</span></a>}
      {project.demo && <a href={project.demo} target="_blank" rel="noopener">{ui.demo} <Fragment set:html={arrow} /></a>}
      {project.code
        ? <a href={project.code} target="_blank" rel="noopener">{ui.code} <Fragment set:html={arrow} /></a>
        : <span class="private">{ui.private}</span>}
    </div>
  </div>
</article>

<style>
  .proj {
    margin-top: 14px; display: flex; gap: 14px; padding: 16px 18px;
    border-radius: 16px; border: 1px solid #ffffff1a;
    background: linear-gradient(135deg, #ffffff0d, #ffffff03); backdrop-filter: blur(10px);
    max-width: 460px; transition: transform .3s, border-color .3s;
  }
  .proj:hover, .proj:focus-within { transform: translateY(-3px); border-color: var(--accent); }
  .bar { width: 4px; align-self: stretch; border-radius: 4px; background: linear-gradient(var(--accent), var(--accent2)); flex: none; }
  .body { flex: 1; min-width: 0; }
  .name { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .tag { font-size: 11px; font-weight: 600; letter-spacing: .04em; padding: 3px 8px; border-radius: 999px; border: 1px solid var(--accent); color: var(--accent); }
  small { color: var(--muted); display: block; font-size: 12px; margin-top: 4px; line-height: 1.4; }
  .links { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; margin-top: 10px; font-size: 13px; font-weight: 600; }
  .links a { display: inline-flex; align-items: center; gap: 4px; color: var(--accent); text-decoration: none; }
  .links a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .private { color: var(--muted); font-weight: 500; }
  .hint { margin-top: 10px; font-size: 12px; color: var(--text); opacity: .85; }
  .links .details-btn {
    padding: 8px 14px; border-radius: 999px; color: #05060a; font-weight: 700;
    background-color: var(--accent);
    background-image: linear-gradient(90deg, var(--accent), var(--accent2));
    box-shadow: 0 6px 22px color-mix(in srgb, var(--accent) 35%, transparent);
    transition: transform .25s, box-shadow .25s;
  }
  .links .details-btn:hover, .links .details-btn:focus-visible { text-decoration: none; transform: translateY(-2px); box-shadow: 0 10px 28px color-mix(in srgb, var(--accent) 50%, transparent); }
  .links .details-btn span { transition: transform .25s; }
  .links .details-btn:hover span { transform: translateX(3px); }
</style>
