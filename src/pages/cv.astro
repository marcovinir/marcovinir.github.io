---
import Base from '../layouts/Base.astro';
import { person, education, experience, areas, tools } from '../data/cv';

const projects = areas.flatMap(a => a.projects);
const portfolio = Astro.site ? Astro.site.host : '';
---

<Base title={`CV · ${person.name}`} description={`Currículum de ${person.name}, ${person.role}.`} noindex>
  <main class="cv">
    <header>
      <div>
        <h1>{person.name}</h1>
        <p class="role">{person.role}</p>
      </div>
      <ul class="contact">
        <li><a href={`mailto:${person.email}`}>{person.email}</a></li>
        <li><a href={person.github}>{person.github.replace('https://', '')}</a></li>
        <li><a href={person.linkedin}>linkedin.com/in/marco-vinicio-rojas-peña</a></li>
        {portfolio && <li><a href={Astro.site}>{portfolio}</a></li>}
      </ul>
    </header>

    <section>
      <h2>Perfil</h2>
      {person.about.map(p => <p>{p}</p>)}
    </section>

    <section>
      <h2>Experiencia</h2>
      {experience.map(e => (
        <article>
          <div class="row"><h3>{e.title}</h3><span class="period">{e.period}</span></div>
          <p class="org">{e.org}</p>
          {e.bullets && <ul>{e.bullets.map(b => <li>{b}</li>)}</ul>}
          {e.links && <p class="link">{e.links.map(l => l.label).join(' · ')}</p>}
        </article>
      ))}
    </section>

    <section>
      <h2>Educación</h2>
      {education.map(e => (
        <article>
          <div class="row"><h3>{e.title}</h3><span class="period">{e.period}</span></div>
          <p class="org">{e.org}</p>
        </article>
      ))}
    </section>

    <section>
      <h2>Proyectos</h2>
      {projects.map(p => (
        <article class="proj">
          <div class="row">
            <h3>{p.name}{p.inProgress && ' (en desarrollo)'}{p.team && <span class="tag">En equipo</span>}</h3>
            <span class="period">{p.href.replace('https://', '').replace(/\/$/, '')}</span>
          </div>
          <p>{p.summary}. {p.stack}.</p>
        </article>
      ))}
    </section>

    <section>
      <h2>Habilidades</h2>
      <dl class="skills">
        {areas.map(a => (<><dt>{a.label}</dt><dd>{a.skills.join(' · ')}</dd></>))}
        <dt>Herramientas</dt><dd>{tools.join(' · ')}</dd>
      </dl>
    </section>
  </main>
</Base>

<style is:global>
  @page { size: A4; margin: 14mm; }
  :root { color-scheme: light !important; background: #fff !important; }
  html, body { background: #fff !important; color: #1a1d29 !important; }
  body { font-size: 10.5pt; overflow: visible; }
</style>

<style>
  .cv { max-width: 182mm; margin: 0 auto; padding: 24px 0; line-height: 1.4; }
  @media print { .cv { padding: 0; } }
  a { color: inherit; text-decoration: none; }
  header { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; padding-bottom: 10px; border-bottom: 2px solid #6366f1; }
  h1 { font-size: 24pt; letter-spacing: -.02em; line-height: 1.05; }
  .role { color: #6366f1; font-weight: 600; margin-top: 2px; }
  .contact { list-style: none; text-align: right; font-size: 9.5pt; color: #4b5068; }
  section { margin-top: 11px; min-height: 0; display: block; padding: 0; overflow: visible; }
  h2 { font-size: 10pt; text-transform: uppercase; letter-spacing: .14em; color: #6366f1; margin: 0 0 5px; line-height: 1.2; }
  h3 { font-size: 10.5pt; font-weight: 700; }
  p { margin-top: 3px; }
  article { margin-top: 5px; }
  .row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .period { font-size: 9pt; color: #6b7088; white-space: nowrap; }
  .org { color: #4b5068; margin-top: 0; }
  ul { padding-left: 16px; margin-top: 2px; }
  .link { font-size: 9pt; color: #6b7088; }
  .proj p { margin-top: 1px; color: #3a3f55; }
  .tag { font-size: 8pt; font-weight: 600; color: #6366f1; border: 1px solid #6366f1; border-radius: 999px; padding: 0 6px; margin-left: 8px; vertical-align: 1px; }
  .skills { display: grid; grid-template-columns: 42mm 1fr; gap: 3px 10px; }
  dt { font-weight: 700; }
  dd { color: #3a3f55; }
</style>
