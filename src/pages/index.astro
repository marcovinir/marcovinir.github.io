---
import Base from '../layouts/Base.astro';
import Rail from '../components/Rail.astro';
import Hero from '../components/Hero.astro';
import Perfil from '../components/Perfil.astro';
import Experiencia from '../components/Experiencia.astro';
import ComoTrabajo from '../components/ComoTrabajo.astro';

const rail = [
  { id: 'hero', color: '#ffffff', label: 'Inicio' },
  { id: 'perfil', color: '#ffffff', label: 'Sobre mí' },
  { id: 'experiencia', color: '#38bdf8', label: 'Experiencia' },
  { id: 'como-trabajo', color: '#a78bfa', label: 'Cómo trabajo' },
];
---

<Base
  title="Marco Rojas · Full-stack developer"
  description="Portafolio y CV de Marco Rojas, desarrollador full-stack: frontend, backend, tiempo real y despliegue."
>
  <Rail items={rail} />
  <main>
    <Hero />
    <Perfil />
    <Experiencia />
    <ComoTrabajo />
  </main>
</Base>

<script>
  import '../scripts/reveal';
</script>
