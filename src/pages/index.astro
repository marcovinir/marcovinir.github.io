---
import Base from '../layouts/Base.astro';
import Rail from '../components/Rail.astro';
import Hero from '../components/Hero.astro';
import Perfil from '../components/Perfil.astro';
import Experiencia from '../components/Experiencia.astro';
import ComoTrabajo from '../components/ComoTrabajo.astro';
import AreasIntro from '../components/AreasIntro.astro';
import Area from '../components/Area.astro';
import Waves from '../components/visuals/Waves.astro';
import IsoBlocks from '../components/visuals/IsoBlocks.astro';
import Embers from '../components/visuals/Embers.astro';
import Streams from '../components/visuals/Streams.astro';
import { areas } from '../data/cv';

const visuals = { fluir: Waves, cimientos: IsoBlocks, chispa: Embers, horizonte: Streams };

const rail = [
  { id: 'hero', color: '#ffffff', label: 'Inicio' },
  { id: 'perfil', color: '#ffffff', label: 'Sobre mí' },
  { id: 'experiencia', color: '#38bdf8', label: 'Experiencia' },
  { id: 'como-trabajo', color: '#a78bfa', label: 'Cómo trabajo' },
  ...areas.map(a => ({ id: a.id, color: a.id === 'horizonte' ? a.color2 : a.color, label: a.label })),
];
---

<Base
  title="Marco Rojas · Full-stack developer"
  description="Portafolio y CV de Marco Rojas, desarrollador full-stack: frontend, backend, tiempo real y despliegue."
>
  <Rail items={rail} />
  <main>
    <Hero />
    <Perfil />
    <Experiencia />
    <ComoTrabajo />
    <AreasIntro />
    {areas.map(a => {
      const Visual = visuals[a.id];
      return <Area area={a}><Visual slot="visual" /></Area>;
    })}
  </main>
</Base>

<script>
  import '../scripts/reveal';
</script>
